# Canonical base URL for the site — used in OG tags, canonical links, and JSON-LD.
# No trailing slash. Defaults to https://www.mokhalab.com if not set.
NEXT_PUBLIC_SITE_URL=https://www.mokhalab.com

# Contact form — SES sender and recipient.
# Both addresses must be verified in AWS SES before use.
# While your SES account is in sandbox mode, the recipient must also be verified.
CONTACT_FROM_EMAIL=hello@mokhalab.com
CONTACT_TO_EMAIL=hello@mokhalab.com
